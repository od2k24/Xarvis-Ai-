// frontend/js/chat.js

import { CONFIG } from "./config.js";

// ==================================================
// HELPERS
// ==================================================

function sleep(ms) {
  return new Promise((resolve) => {
    setTimeout(resolve, ms);
  });
}

async function readJson(response) {
  try {
    return await response.json();
  } catch {
    return {};
  }
}

// ==================================================
// NORMAL CHAT
// ==================================================

export async function sendChat(
  message,
  history = []
) {
  if (
    typeof message !== "string" ||
    !message.trim()
  ) {
    throw new Error(
      "Chat message cannot be empty."
    );
  }

  const safeHistory =
    Array.isArray(history)
      ? history.slice(-CONFIG.MAX_HISTORY)
      : [];

  const response = await fetch(
    `${CONFIG.API_BASE}${CONFIG.ROUTES.CHAT}`,
    {
      method: "POST",

      headers: {
        "Content-Type": "application/json",
      },

      body: JSON.stringify({
        message: message.trim(),
        history: safeHistory,
      }),
    }
  );

  const data = await readJson(response);

  if (!response.ok) {
    throw new Error(
      data?.error ||
        `Chat request failed (${response.status})`
    );
  }

  return data;
}

// ==================================================
// RETRY CHAT
// ==================================================

export async function fetchWithRetry(
  url,
  options = {},
  attempts = CONFIG.RETRY_ATTEMPTS
) {
  let lastError;

  for (
    let attempt = 0;
    attempt <= attempts;
    attempt++
  ) {
    try {
      const response =
        await fetch(url, options);

      if (
        response.ok ||
        attempt === attempts
      ) {
        return response;
      }

      await sleep(CONFIG.RETRY_DELAY);
    } catch (error) {
      lastError = error;

      if (attempt === attempts) {
        throw error;
      }

      await sleep(CONFIG.RETRY_DELAY);
    }
  }

  throw (
    lastError ||
    new Error("Request failed.")
  );
}

// ==================================================
// STREAM CHAT
// ==================================================

export async function streamChat(
  message,
  history = [],
  onChunk = () => {}
) {
  if (
    typeof message !== "string" ||
    !message.trim()
  ) {
    throw new Error(
      "Chat message cannot be empty."
    );
  }

  const safeHistory =
    Array.isArray(history)
      ? history.slice(-CONFIG.MAX_HISTORY)
      : [];

  const controller =
    new AbortController();

  const timeoutId = setTimeout(() => {
    controller.abort();
  }, CONFIG.REQUEST_TIMEOUT);

  try {
    const response =
      await fetchWithRetry(
        `${CONFIG.API_BASE}${CONFIG.ROUTES.STREAM}`,
        {
          method: "POST",

          headers: {
            "Content-Type": "application/json",
            Accept: "text/event-stream",
          },

          body: JSON.stringify({
            message: message.trim(),
            history: safeHistory,
          }),

          signal: controller.signal,
        }
      );

    if (!response.ok) {
      const data = await readJson(response);

      throw new Error(
        data?.error ||
          `Stream request failed (${response.status})`
      );
    }

    if (!response.body) {
      throw new Error(
        "Streaming is not supported by this response."
      );
    }

    const reader =
      response.body.getReader();

    const decoder =
      new TextDecoder("utf-8");

    let buffer = "";
    let fullText = "";

    while (true) {
      const {
        value,
        done,
      } = await reader.read();

      if (done) {
        break;
      }

      buffer += decoder.decode(
        value,
        { stream: true }
      );

      const events =
        buffer.split("\n\n");

      buffer =
        events.pop() || "";

      for (const event of events) {
        const lines =
          event.split("\n");

        for (const line of lines) {
          if (
            !line.startsWith("data:")
          ) {
            continue;
          }

          const raw =
            line.slice(5).trim();

          if (!raw) {
            continue;
          }

          if (raw === "[DONE]") {
            return fullText;
          }

          let parsed;

          try {
            parsed = JSON.parse(raw);
          } catch {
            continue;
          }

          if (
            parsed.type === "error"
          ) {
            throw new Error(
              parsed.error ||
                "Xarvis streaming error."
            );
          }

          if (
            parsed.type === "done"
          ) {
            continue;
          }

          const chunk =
            parsed.delta ??
            parsed.content ??
            "";

          if (!chunk) {
            continue;
          }

          fullText += chunk;

          onChunk(chunk);
        }
      }
    }

    return fullText;
  } finally {
    clearTimeout(timeoutId);
  }
}
