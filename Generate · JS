// frontend/js/generate.js

import { CONFIG } from "./config.js";

async function callGenerate(payload) {
  const controller = new AbortController();

  const timeoutId = setTimeout(() => {
    controller.abort();
  }, CONFIG.REQUEST_TIMEOUT);

  try {
    const response = await fetch(
      `${CONFIG.API_BASE}${CONFIG.ROUTES.GENERATE}`,
      {
        method: "POST",
        headers: {
          "Content-Type": "application/json",
        },
        body: JSON.stringify(payload),
        signal: controller.signal,
      }
    );

    const data = await response.json().catch(() => ({}));

    if (!response.ok) {
      throw new Error(
        data.error || `Generation failed (${response.status})`
      );
    }

    return data;
  } finally {
    clearTimeout(timeoutId);
  }
}

export async function generateViral(
  topic,
  platform,
  memory = {}
) {
  return callGenerate({
    type: "viral",
    topic,
    platform,
    memory,
  });
}

export async function generatePostNext(memory = {}) {
  return callGenerate({
    type: "postnext",
    memory,
  });
}

export async function generateCalendar(memory = {}) {
  return callGenerate({
    type: "calendar",
    memory,
  });
}

export async function analyzeFeedback(
  content,
  memory = {}
) {
  return callGenerate({
    type: "feedback",
    content,
    memory,
  });
}
