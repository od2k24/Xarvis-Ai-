// frontend/js/agents.js

import { CONFIG } from "./config.js";

// ==================================================
// BUILD AGENT PROMPT
// ==================================================

function buildAgentPrompt(
  goal,
  memory = {}
) {
  return `
You are Xarvis Agent.

The user wants to accomplish this goal:

${goal}

Here is the user's available context/memory:

${JSON.stringify(
  memory || {},
  null,
  2
)}

Your job is to help the user actually move
towards the goal.

Give practical actions.

Prioritize:
1. The immediate next action.
2. The steps after that.
3. Important decisions.
4. Problems or blockers.
5. The best strategy.
6. What the user should do next.

Do not pretend that work has already been completed.

Be specific and useful.
`.trim();
}

// ==================================================
// AGENT
// ==================================================

export async function runAgent(
  goal,
  memory = {},
  onChunk = () => {}
) {
  if (
    typeof goal !== "string" ||
    !goal.trim()
  ) {
    throw new Error(
      "Agent goal cannot be empty."
    );
  }

  const controller =
    new AbortController();

  const timeoutId = setTimeout(() => {
    controller.abort();
  }, CONFIG.REQUEST_TIMEOUT);

  try {
    // ----------------------------------------------
    // FIRST: STREAMING AGENT
    // ----------------------------------------------

    try {
      const response =
        await fetch(
          `${CONFIG.API_BASE}${CONFIG.ROUTES.STREAM}`,
          {
            method: "POST",

            headers: {
              "Content-Type": "application/json",
              Accept: "text/event-stream",
            },

            body: JSON.stringify({
              message: buildAgentPrompt(
                goal,
                memory
              ),
              history: [],
            }),

            signal: controller.signal,
          }
        );

      if (!response.ok) {
        throw new Error(
          `Agent request failed (${response.status})`
        );
      }

      if (!response.body) {
        throw new Error(
          "Agent streaming unavailable."
        );
      }

      const reader =
        response.body.getReader();

      const decoder =
        new TextDecoder("utf-8");

      let buffer = "";
      let fullText = "";

      while (true) {
        const {
          value,
          done,
        } = await reader.read();

        if (done) {
          break;
        }

        buffer += decoder.decode(
          value,
          { stream: true }
        );

        const events =
          buffer.split("\n\n");

        buffer =
          events.pop() || "";

        for (const event of events) {
          const lines =
            event.split("\n");

          for (const line of lines) {
            if (
              !line.startsWith("data:")
            ) {
              continue;
            }

            const raw =
              line.slice(5).trim();

            if (!raw) {
              continue;
            }

            if (raw === "[DONE]") {
              return fullText;
            }

            let parsed;

            try {
              parsed =
                JSON.parse(raw);
            } catch {
              continue;
            }

            if (
              parsed.type === "error"
            ) {
              throw new Error(
                parsed.error ||
                  "Agent streaming failed."
              );
            }

            if (
              parsed.type === "done"
            ) {
              continue;
            }

            const chunk =
              parsed.delta ??
              parsed.content ??
              "";

            if (!chunk) {
              continue;
            }

            fullText += chunk;

            onChunk(chunk);
          }
        }
      }

      if (fullText) {
        return fullText;
      }

      throw new Error(
        "Agent returned an empty response."
      );
    } catch (streamError) {
      console.warn(
        "Agent streaming failed. Using fallback:",
        streamError.message
      );
    }

    // ----------------------------------------------
    // FALLBACK: GENERATE
    // ----------------------------------------------

    const fallbackResponse =
      await fetch(
        `${CONFIG.API_BASE}${CONFIG.ROUTES.GENERATE}`,
        {
          method: "POST",

          headers: {
            "Content-Type": "application/json",
          },

          body: JSON.stringify({
            type: "agent",
            goal: goal.trim(),
            memory,
          }),

          signal: controller.signal,
        }
      );

    const data =
      await fallbackResponse
        .json()
        .catch(() => ({}));

    if (!fallbackResponse.ok) {
      throw new Error(
        data?.error ||
          `Agent fallback failed (${fallbackResponse.status})`
      );
    }

    const result =
      data?.result ||
      data?.content ||
      data?.reply ||
      "";

    if (!result) {
      throw new Error(
        "Agent returned an empty response."
      );
    }

    onChunk(result);

    return result;

  } finally {
    clearTimeout(timeoutId);
  }
}

// ==================================================
// EXPORT
// ==================================================

export {
  buildAgentPrompt,
};
